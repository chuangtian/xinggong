    <li class="d-flex"><a href="javascript:;" class="p-2"><span class="flag-icon flag-icon-gb" style="font-size:2em;" onclick="changeLanguage('en')"></span></a></li>
    <li class="d-flex"><a href="javascript:;" class="p-2"><span class="flag-icon flag-icon-cn" style="font-size:2em;" onclick="changeLanguage('cn')"></span></a></li>
</ul>

<script>
    var language_url = "https://sandboxico.fmchain.io/updateLanguage";
    var c_language = "en";
    var language = "";
    if(language == '' || language == undefined){
        language = localStorage.getItem('language') ? localStorage.getItem('language') : 'en';
        if(c_language != ''){
            language = c_language;
            localStorage.setItem('language', language);
        }
    }else{
        if(c_language == language){
            localStorage.setItem('language', language);
        }else{
            $.ajax({
                url: language_url,
                type: 'post',
                data: {
                    language: language,
                    _token: $('input[name=_token]').val()
                },
                dataType: 'json',
                success: function(res) {
                    if(res.code == 200){
                        localStorage.setItem('language', language);
                        location.href = location.href;
                    }
                }
            });
        }
    }
    localStorage.getItem('language')=='cn'?($('#lang_dropdown').find('.flag-icon-gb').css("background-image",'url(../flags/4x3/cn.svg)')):($('#lang_dropdown').find('.flag-icon-gb').css("background-image",'url(../flags/4x3/gb.svg)'))
    function changeLanguage(language){
        // localStorage.setItem('language', language)
        if(language == 'en'){
            $('#lang_dropdown').find('.flag-icon-gb').css("background-image",'url(../flags/4x3/gb.svg)');
        }else if(language == 'cn'){
            $('#lang_dropdown').find('.flag-icon-gb').css("background-image",'url(../flags/4x3/cn.svg)');
        }
        $.ajax({
            url: language_url,
            type: 'post',
            data: {
                language: language,
                _token: $('input[name=_token]').val()

            },
            dataType: 'json',
            success: function(res) {
                if(res.code == 200){
                    localStorage.setItem('language', language);
                    success_prompt(res.msg, 2000);
                    setTimeout(function(){
                        location.href = location.href;
                    }, 1000);
                }else{
                    fail_prompt('Try Again.', 3000);
                }
            },
            error: function(data) {
                fail_prompt('Try Again.', 3000);
            }
        });
    }
</script>
</div>

<div class="box m-auto">
    <div class="error d-flex align-items-center justify-content-center flex-column">
        <img src="https://sandboxico.fmchain.io/error/img/500.png" class="mw-100 mb-5">
        <h6 class="text-dark">Internal server error</h6>
    </div>
</div>
</body>
</html>
