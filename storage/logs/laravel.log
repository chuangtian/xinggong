<div class="header w-100 d-flex justify-content-between align-items-center pl-md-3 pr-md-3 pt-1 pb-1">
    <a class="logo cursor" href="https://sandboxico.fmchain.io"><img src="https://sandboxico.fmchain.io/error/img/logo_2.png"></a>
    <div id="lang_dropdown" class="dropdown-toggle bg-transparent cursor" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <span class="flag-icon flag-icon-gb"></span>
        <span class="caret"></span>
</div>
